# Copy to .env and adjust. Never commit .env.

# MongoDB connection string. `docker compose up -d` starts a local instance on this URI.
MONGO_URI=mongodb://localhost:27017/muraqaba

# Secret used to sign JWTs. Use a long random string (at least 32 chars; required in production).
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

# How long a login lasts (jsonwebtoken format: 24h, 7d, 30m).
JWT_EXPIRES_IN=24h

PORT=5000
NODE_ENV=development

# Browser origins allowed by CORS, comma separated.
FRONTEND_URL=http://localhost:3000

# Self registration. Defaults: development allows every role; production is off unless
# ALLOW_PUBLIC_REGISTRATION=true, and then only the roles in SELF_REGISTER_ROLES (default: vendor).
# Never list supervisor or serviceCreator on a public deployment.
# ALLOW_PUBLIC_REGISTRATION=false
# SELF_REGISTER_ROLES=vendor

# Set only when a reverse proxy in front of the API sets X-Forwarded-For: the number of
# proxies (1) or a subnet (loopback, 10.0.0.0/8). Leave unset if clients reach the API directly.
# TRUST_PROXY=1

# Optional rate limiting overrides (requests per 15 minute window per IP).
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_MAX=20

# Optional: password used for the demo accounts created by `npm run seed`.
# SEED_PASSWORD=Password123!
