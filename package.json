{
  "name": "muraqaba-api",
  "version": "1.1.0",
  "description": "Muraqaba fleet maintenance ticketing API (Express + MongoDB)",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seed.js",
    "seed:reset": "node scripts/seed.js --reset",
    "test": "node tests/run.mjs",
    "docs:generate": "node scripts/generate-swagger.mjs",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose down",
    "db:local": "node scripts/dev-mongo.mjs"
  },
  "keywords": [
    "fleet",
    "maintenance",
    "tickets",
    "express",
    "mongodb"
  ],
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.13.1",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^3.1.9"
  }
}
